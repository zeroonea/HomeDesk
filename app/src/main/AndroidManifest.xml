<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- web notifications from apps (NotificationBridge); Android 13+ asks the user -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- microphone for web pages (getUserMedia, MediaPermissions); Android asks the user.
         MODIFY_AUDIO_SETTINGS lets WebView's WebRTC switch audio routing/echo cancellation (no prompt). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- read-aloud (SpeechBridge): Android 11+ hides the TTS engine unless the app declares it looks for one -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.HomeDesk"
        android:usesCleartextTraffic="true"
        android:allowBackup="true">

        <!-- Site list (the app's home screen). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".UsageActivity"
            android:exported="false"
            android:label="Usage" />

        <!-- Touchpad settings HyperOS hides; changed as the shell user through this tablet's own
             Wireless debugging (AdbShell). -->
        <activity
            android:name=".TouchpadActivity"
            android:exported="false"
            android:label="Touchpad" />

        <!-- Receives the pairing code typed into the pairing notification (AdbPairing). -->
        <receiver
            android:name=".AdbPairing"
            android:exported="false" />

        <!--
          One full-screen WebView per site. documentLaunchMode=intoExisting gives every site its own
          entry in Android's Recents (intent data = homedesk://site/<id>), so several apps stay open
          side by side and switching between them does not reload anything.
          configChanges: rotating or folding/unfolding must not recreate the activity (that would
          drop the remote session).
        -->
        <activity
            android:name=".WebActivity"
            android:exported="false"
            android:documentLaunchMode="intoExisting"
            android:autoRemoveFromRecents="true"
            android:theme="@style/Theme.HomeDesk.Web"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|layoutDirection" />
    </application>
</manifest>
