<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Site list: keep the classic layout under the action bar (Android 15 would draw the list behind it). -->
    <style name="Theme.HomeDesk" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:colorAccent">#3D7BFD</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="Theme.HomeDesk.Web" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#3D7BFD</item>
    </style>
</resources>
